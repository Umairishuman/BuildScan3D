# Copy to .env and fill in. .env is gitignored and must never be committed.

# RunPod API key, from https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=

# local | runpod | remote | dry_run
PROCESSING_MODE=dry_run

# Optional overrides
# RUNPOD_GPU_TYPE=RTX 4090
# MAX_POD_LIFETIME=7200
# REMOTE_GPU_HOST=
# REMOTE_GPU_PORT=22
# REMOTE_GPU_USER=root

# Online site (D-076): Cloudflare R2 bucket for scripts/buildscan publish (scripts/publish_scan.py).
# Token: R2 -> Manage API tokens -> Object Read & Write, this bucket only. Each person uses their own owner id.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL (https://pub-....r2.dev); the Vercel project gets the same value as SCANS_BASE_URL
R2_PUBLIC_URL=
# Whose scans these are: lower case id (umair, tayyab) and the name shown on the cards
PUBLISH_OWNER=
PUBLISH_OWNER_NAME=
