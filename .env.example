# Copy to .env and fill in. .env is gitignored and must never be committed.

# RunPod API key, from https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=

# local | runpod | remote | dry_run
PROCESSING_MODE=dry_run

# Optional overrides
# RUNPOD_GPU_TYPE=RTX 4090
# MAX_POD_LIFETIME=7200
# REMOTE_GPU_HOST=
# REMOTE_GPU_PORT=22
# REMOTE_GPU_USER=root
