<resources>

  <!-- BuildScan 3D: light theme in the logo's blues (colors.xml). Every screen uses it; the capture screen draws the
       camera full screen on top of it. -->
  <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="colorPrimary">@color/bs_primary</item>
    <item name="colorPrimaryDark">@color/bs_card</item>
    <item name="colorAccent">@color/bs_primary</item>
    <item name="android:windowBackground">@color/bs_bg</item>
    <item name="android:statusBarColor">@color/bs_card</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:navigationBarColor">@color/bs_card</item>
    <item name="android:textColorPrimary">@color/bs_text</item>
    <item name="android:textColorSecondary">@color/bs_text_secondary</item>
  </style>

  <!-- Capture screen: same theme, dark status bar over the camera image. -->
  <style name="AppTheme.Capture">
    <item name="android:statusBarColor">#000000</item>
    <item name="android:windowLightStatusBar">false</item>
  </style>

</resources>
